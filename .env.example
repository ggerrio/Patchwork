# ==========================================
# PATCHWORK — ZERO-COST PRODUCTION ENV VARS
# ==========================================

# 1. Database (Supabase Free Tier - Session/Transaction Pooler URL)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 2. Redis (Redis Cloud Free Tier non-TLS `redis://` or Upstash TLS `rediss://`)
REDIS_URL=redis://default:[password]@[endpoint].redns.redis-cloud.com:12345

# 3. LLM & Embeddings (Google AI Studio Free Tier & Groq Free Tier)
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...
PRIMARY_LLM_PROVIDER=gemini

# 4. Isolated Code Sandbox (Local Docker)
SANDBOX_IMAGE=patchwork-sandbox:latest

# 5. GitHub Integration (Personal Access Token with 'repo' scope)
GITHUB_TOKEN=ghp_...

# 6. Security & App Config
WEBHOOK_SECRET=change-this-to-a-random-hex-string
MAX_AGENT_RETRIES=3
MAX_FILES_PER_PATCH=3
NEXT_PUBLIC_API_URL=http://localhost:8000
